{
  "manifest_version": 3,
  "name": "SignalForge — Olymp Trade Read-only Companion",
  "version": "1.1.3",
  "description": "Shares visible Olymp Trade instrument and payout labels with SignalForge. Does not read credentials or place trades.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://olymptrade.com/*",
    "https://*.olymptrade.com/*",
    "https://signalforge-ml.ai.studio/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://olymptrade.com/*", "https://*.olymptrade.com/*"],
      "js": ["content/olymptrade.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://signalforge-ml.ai.studio/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/signalforge-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
